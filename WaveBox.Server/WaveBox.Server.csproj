<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>WaveBox</RootNamespace>
    <RuntimeIdentifiers>win-x64;win-arm64;osx-x64;osx-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <!-- IL2104: TagLibSharp has internal trim warnings, but TrimmerRootAssembly preserves it whole -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- TagLibSharp discovers file-format handlers by scanning its own assembly for
         [SupportedMimeType] types and Activator.CreateInstance'ing them; root the whole
         assembly so trimming can't remove any format parser -->
    <TrimmerRootAssembly Include="TagLibSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WaveBox.Core\WaveBox.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WaveBox.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="Mono.Nat" Version="3.0.4" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::UtcNow.ToString('o'))" />
  </ItemGroup>

  <ItemGroup>
    <None Include="res\wavebox.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="res\wavebox_querylog.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="res\wavebox.conf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="res\wavebox.conf.template" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
